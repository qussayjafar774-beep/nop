            },
            {
                id: "c_battery",
                labelAr: "بطارية الليثيوم الصلبة",
                labelEn: "SOLID-STATE BATTERY PACK",
                model: "1200mAh Solid-State Polymer",
                power: "7-10 Days Autonomy",
                desc: "بطارية ذات غلاف فضي معدني مقاومة للانفجار ودرجات الحرارة الشديدة توفر تغذية تشغيلية طويلة الأمد.",
                yOffset: -1.2,
                align: "left"
            },
            {
                id: "c_sensor_ppg",
                labelAr: "حساس النبض والأكسجين PPG",
                labelEn: "MAX86150 PPG OPTICAL PULSE SENSOR",
                model: "Maxim MAX86150 Dual Green/IR",
                power: "Medical Grade PPG & SpO2",
                desc: "المستشعر الطبي الضوئي المزدوج المصنوع من معدن مصقول مع نافذتين مضيئتين بلون أخضر لقياس نبض القلب ونسبة الأكسجين.",
                yOffset: -2.3,
                align: "right"
            },
            {
                id: "c_bottom_strap",
                labelAr: "الحزام السفلي الملامس للبشرة",
                labelEn: "INNER FLEXIBLE TPU STRAP WITH SENSOR CONTACT",
                model: "Hypoallergenic Skin TPU Base",
                power: "IP68 Sensor Cutout Window",
                desc: "السوار السفلي الملامس للمعصم والذي يحتوي على فتحات دقيقة يبرز منها مستشعر PPG لملامسة البشرة مباشرة.",
                yOffset: -3.5,
                align: "left"
            }
        ];

        // Three.js Core Variables
        let scene, camera, renderer, controls;
        let componentMeshMap = new Map();
        let annotationElements = [];
        let explodeProgress = 0.45;
        let isAutoPlay = false;
        let showLabels = true;
        let activeSelectedId = "c_pcb";

        function initScene() {
            const container = document.getElementById('webgl-container');

            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x090d16, 0.025);

            camera = new THREE.PerspectiveCamera(40, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(11, 6, 14);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.35;
            container.appendChild(renderer.domElement);

            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;
            controls.dampingFactor = 0.05;
            controls.maxDistance = 35;
            controls.minDistance = 4;
            controls.target.set(0, 0, 0);

            // Lighting Setup for Photorealistic Metal & TPU Shading
            const ambLight = new THREE.AmbientLight(0xffffff, 0.9);
            scene.add(ambLight);

            const dirLight1 = new THREE.DirectionalLight(0xffffff, 2.2);
            dirLight1.position.set(12, 20, 15);
            dirLight1.castShadow = true;
            dirLight1.shadow.mapSize.width = 2048;
            dirLight1.shadow.mapSize.height = 2048;
            scene.add(dirLight1);

            const cyanRimLight = new THREE.PointLight(0x06b6d4, 3, 25);
            cyanRimLight.position.set(-10, 5, -8);
            scene.add(cyanRimLight);

            const blueFillLight = new THREE.DirectionalLight(0x3b82f6, 1.2);
            blueFillLight.position.set(-10, -10, -5);
            scene.add(blueFillLight);

            // Build Photorealistic Components
            buildBraceletComponents();

            // Create Dynamic Overlay Annotation Pins
            createAnnotationPins();

            // Event Listeners
            window.addEventListener('resize', onWindowResize);
            setupUIInteractions();

            // Start Render Loop
            animate();
        }

        function buildBraceletComponents() {
            // Materials Definition
            const matteTpuMat = new THREE.MeshStandardMaterial({
                color: 0x151922,
                roughness: 0.75,
                metalness: 0.1
            });

            const darkMetalMat = new THREE.MeshStandardMaterial({
                color: 0x222936,
                roughness: 0.25,
                metalness: 0.85
            });

            const pcbGreenMat = new THREE.MeshStandardMaterial({
                color: 0x0d5c2e,
                roughness: 0.35,
                metalness: 0.2
            });

            const goldMat = new THREE.MeshStandardMaterial({
                color: 0xd4af37,
                roughness: 0.2,
                metalness: 0.9
            });

            const silverFoilMat = new THREE.MeshStandardMaterial({
                color: 0xd1d5db,
                roughness: 0.2,
                metalness: 0.85
            });

            const redSosMat = new THREE.MeshStandardMaterial({
                color: 0xd97706,
                emissive: 0xd97706,
                emissiveIntensity: 0.3,
                roughness: 0.3,
                metalness: 0.4
            });

            const solarGridMat = new THREE.MeshStandardMaterial({
                color: 0x1e293b,
                roughness: 0.2,
                metalness: 0.7
            });

            // 1. TOP TPU SHELL (Layer 1)
            const topStrapGroup = new THREE.Group();
            const topShape = new THREE.TorusGeometry(3.2, 0.45, 20, 80, Math.PI * 0.95);
            const topMesh = new THREE.Mesh(topShape, matteTpuMat);
            topMesh.rotation.x = Math.PI / 2;
            topMesh.rotation.z = Math.PI * 0.02;
            topStrapGroup.add(topMesh);
            registerComponent("c_top_strap", topStrapGroup, 3.8);

            // 2. CURVED OLED DISPLAY (Layer 2)
            const displayGroup = new THREE.Group();
            const dispGeom = new THREE.BoxGeometry(2.8, 0.08, 1.5);
            const dispMat = new THREE.MeshStandardMaterial({ color: 0x020617, roughness: 0.1, metalness: 0.9 });
            const dispMesh = new THREE.Mesh(dispGeom, dispMat);

            // Canvas texture for live OLED text metrics
            const canvas = document.createElement('canvas');
            canvas.width = 512;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#020617';
            ctx.fillRect(0, 0, 512, 256);
            ctx.font = 'bold 36px "JetBrains Mono", monospace';
            ctx.fillStyle = '#ef4444';
            ctx.fillText('HEART RATE: 78 BPM', 30, 70);
            ctx.fillStyle = '#38bdf8';
            ctx.fillText('TEMP: 37.1 °C', 30, 140);
            ctx.fillStyle = '#10b981';
            ctx.fillText('SpO2: 98%', 30, 210);

            const texture = new THREE.CanvasTexture(canvas);
            const screenMat = new THREE.MeshBasicMaterial({ map: texture });
            const screenPlane = new THREE.Mesh(new THREE.PlaneGeometry(2.6, 1.3), screenMat);
            screenPlane.rotation.x = -Math.PI / 2;
            screenPlane.position.y = 0.05;
            displayGroup.add(dispMesh, screenPlane);
            registerComponent("c_display", displayGroup, 2.7);

            // 3. MIDDLE METAL FRAME & SOLAR STRIP (Layer 3)
            const solarGroup = new THREE.Group();
            const frameGeom = new THREE.BoxGeometry(3.6, 0.25, 2.0);
            const frameMesh = new THREE.Mesh(frameGeom, darkMetalMat);
            
            // Solar Cell Grid Pattern on Strap Curve
            const solarGeom = new THREE.BoxGeometry(1.8, 0.04, 1.4);
            const solarMesh = new THREE.Mesh(solarGeom, solarGridMat);
            solarMesh.position.set(-1.0, 0.13, 0);
            solarGroup.add(frameMesh, solarMesh);
            registerComponent("c_solar_frame", solarGroup, 1.6);

            // 4. MAIN FLEXIBLE PCB & CHIPS (Layer 4)
            const pcbGroup = new THREE.Group();
            const pcbBase = new THREE.Mesh(new THREE.BoxGeometry(3.3, 0.08, 1.7), pcbGreenMat);
            pcbGroup.add(pcbBase);

            // Main MCU / Edge AI Chip
            const mcuGeom = new THREE.BoxGeometry(0.9, 0.1, 0.9);
            const mcuMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.2 });
            const mcu = new THREE.Mesh(mcuGeom, mcuMat);
            mcu.position.set(-0.6, 0.08, 0);
            pcbGroup.add(mcu);

            // Gold Contact Pads and SMD Components
            for(let i = 0; i < 16; i++) {
                const pad = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.04, 0.08), goldMat);
                pad.position.set((Math.random() - 0.5) * 2.8, 0.05, (Math.random() - 0.5) * 1.3);
                pcbGroup.add(pad);
            }
            registerComponent("c_pcb", pcbGroup, 0.5);

            // 5. BONE CONDUCTION SPEAKER (Layer 5)
            const speakerGroup = new THREE.Group();
            const spkGeom = new THREE.CylinderGeometry(0.35, 0.35, 0.18, 32);
            const spkMesh = new THREE.Mesh(spkGeom, darkMetalMat);
            spkMesh.rotation.z = Math.PI / 2;
            spkMesh.position.set(1.8, 0, -0.4);
            speakerGroup.add(spkMesh);
            registerComponent("c_speaker", speakerGroup, 0.0);

            // 6. RED SOS EMERGENCY BUTTON (Layer 6)
            const sosGroup = new THREE.Group();
            const btnGeom = new THREE.CylinderGeometry(0.28, 0.28, 0.35, 32);
            const btnMesh = new THREE.Mesh(btnGeom, redSosMat);
            btnMesh.rotation.z = Math.PI / 2;
            btnMesh.position.set(1.8, 0, 0.4);
            sosGroup.add(btnMesh);
            registerComponent("c_sos_btn", sosGroup, -0.6);

            // 7. SOLID-STATE BATTERY PACK (Layer 7)
            const batGroup = new THREE.Group();
            const batGeom = new THREE.BoxGeometry(2.6, 0.22, 1.4);
            const batMesh = new THREE.Mesh(batGeom, silverFoilMat);
            batGroup.add(batMesh);
            registerComponent("c_battery", batGroup, -1.2);

            // 8. MAX86150 MEDICAL PPG OPTICAL SENSOR (Layer 8)
            const ppgGroup = new THREE.Group();
            const ppgBase = new THREE.Mesh(new THREE.BoxGeometry(1.2, 0.12, 0.8), darkMetalMat);
            
            // Dual Green Illuminated LED Windows
            const ledGeom = new THREE.CylinderGeometry(0.12, 0.12, 0.15, 16);
            const ledMat = new THREE.MeshBasicMaterial({ color: 0x10b981 });
            const led1 = new THREE.Mesh(ledGeom, ledMat);
            led1.position.set(-0.3, -0.02, 0);
            const led2 = led1.clone();
            led2.position.set(0.3, -0.02, 0);

            ppgGroup.add(ppgBase, led1, led2);
            registerComponent("c_sensor_ppg", ppgGroup, -2.3);

            // 9. INNER TPU STRAP BASE (Layer 9)
            const botStrapGroup = new THREE.Group();
            const botShape = new THREE.TorusGeometry(3.2, 0.45, 20, 80, Math.PI * 0.95);
            const botMesh = new THREE.Mesh(botShape, matteTpuMat);
            botMesh.rotation.x = Math.PI / 2;
            botMesh.rotation.z = -Math.PI * 0.97;
            botStrapGroup.add(botMesh);
            registerComponent("c_bottom_strap", botStrapGroup, -3.5);

            updateExplosionPositions();
        }

        function registerComponent(id, group, baseOffsetY) {
            group.userData = { id: id, baseOffsetY: baseOffsetY };
            scene.add(group);
            componentMeshMap.set(id, group);
        }

        function updateExplosionPositions() {
            const verticalSpread = 1.1;
            componentMeshMap.forEach((group) => {
                const baseOffsetY = group.userData.baseOffsetY;
                group.position.y = baseOffsetY * explodeProgress * verticalSpread;
            });
        }

        function createAnnotationPins() {
            const overlay = document.getElementById('annotations-overlay');
            overlay.innerHTML = '';
            annotationElements = [];

            COMPONENT_DATA.forEach((comp) => {
                const pinContainer = document.createElement('div');
                pinContainer.className = 'annotation-pin flex items-center gap-2';
                pinContainer.dataset.id = comp.id;

                const isLeft = comp.align === 'left';

                const labelBox = `
                    <div class="glass-card px-3 py-1.5 rounded-xl border border-cyan-500/40 text-right whitespace-nowrap">
                        <div class="text-[10px] text-cyan-400 font-bold mono-font">${comp.labelEn}</div>
                        <div class="text-xs font-black text-white">${comp.labelAr}</div>
                    </div>
                `;

                const dot = `
                    <div class="w-4 h-4 rounded-full bg-cyan-500/20 border-2 border-cyan-400 flex items-center justify-center">
                        <div class="w-1.5 h-1.5 rounded-full bg-cyan-300 animate-ping"></div>
                    </div>
                `;

                pinContainer.innerHTML = isLeft ? (labelBox + dot) : (dot + labelBox);

                pinContainer.addEventListener('click', () => {
                    selectComponent(comp.id);
                });

                overlay.appendChild(pinContainer);

                annotationElements.push({
                    id: comp.id,
                    element: pinContainer
                });
            });
        }

        function updateAnnotationPositions() {
            if (!showLabels) {
                annotationElements.forEach(item => item.element.style.opacity = '0');
                return;
            }

            const tempVec = new THREE.Vector3();

            annotationElements.forEach(item => {
                const group = componentMeshMap.get(item.id);
                if (!group) return;

                group.getWorldPosition(tempVec);

                // Project 3D vector to 2D Screen Space
                tempVec.project(camera);

                // Check if behind camera
                if (tempVec.z > 1) {
                    item.element.style.opacity = '0';
                    return;
                }

                const x = (tempVec.x * 0.5 + 0.5) * window.innerWidth;
                const y = (-(tempVec.y * 0.5) + 0.5) * window.innerHeight;

                item.element.style.left = `${x}px`;
                item.element.style.top = `${y}px`;
                item.element.style.opacity = '1';
            });
        }

        function selectComponent(id) {
            activeSelectedId = id;
            const comp = COMPONENT_DATA.find(c => c.id === id);
            if (!comp) return;

            // Update Left Spec Card Drawer
            document.getElementById('card-badge').textContent = comp.labelEn;
            document.getElementById('card-title').textContent = comp.labelAr;
            document.getElementById('card-subtitle').textContent = comp.id.toUpperCase();
            document.getElementById('card-desc').textContent = comp.desc;
            document.getElementById('card-model').textContent = comp.model;
            document.getElementById('card-power').textContent = comp.power;

            // Highlight selected component mesh
            componentMeshMap.forEach((group, gId) => {
                group.scale.set(1, 1, 1);
                if (gId === id) {
                    group.scale.set(1.12, 1.12, 1.12);
                }
            });
        }

        function setupUIInteractions() {
            // Explode Slider Event
            const slider = document.getElementById('explode-slider');
            const percentTxt = document.getElementById('explode-percent');

            slider.addEventListener('input', (e) => {
                const val = parseFloat(e.target.value) / 100;
                explodeProgress = val;
                percentTxt.textContent = `${e.target.value}%`;
                updateExplosionPositions();
            });

            // Auto Explode Animation Button
            const autoBtn = document.getElementById('auto-explode-btn');
            autoBtn.addEventListener('click', () => {
                isAutoPlay = !isAutoPlay;
                document.getElementById('auto-btn-txt').textContent = isAutoPlay ? "إيقاف الأنيميشن" : "تشغيل أنيميشن التفكيك";
            });

            // Reset Camera
            document.getElementById('reset-cam-btn').addEventListener('click', () => {
                camera.position.set(11, 6, 14);
                controls.target.set(0, 0, 0);
            });

            // Toggle Labels
            document.getElementById('toggle-labels-btn').addEventListener('click', () => {
                showLabels = !showLabels;
            });

            // View Presets
            document.querySelectorAll('.view-preset').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const preset = e.target.dataset.preset;
                    if (preset === 'top') camera.position.set(0, 18, 0.1);
                    if (preset === 'front') camera.position.set(0, 0, 16);
                    if (preset === 'diag') camera.position.set(11, 6, 14);
                    controls.target.set(0, 0, 0);
                });
            });

            // Re-init Lucide Icons
            lucide.createIcons();
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);

            if (isAutoPlay) {
                explodeProgress += 0.005;
                if (explodeProgress > 1.0) explodeProgress = 0.0;
                document.getElementById('explode-slider').value = Math.round(explodeProgress * 100);
                document.getElementById('explode-percent').textContent = `${Math.round(explodeProgress * 100)}%`;
                updateExplosionPositions();
            }

            // Slow assembly rotation
            scene.rotation.y += 0.002;

            controls.update();
            updateAnnotationPositions();
            renderer.render(scene, camera);
        }

        // Initialize App on Window Load
        window.onload = () => {
            initScene();
            selectComponent("c_pcb");
        };
    </script>
</body>
</html>
