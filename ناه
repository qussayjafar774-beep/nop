<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AIHS-2026 Smart Bracelet - Ultra Photorealistic 3D Exploded View</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js, OrbitControls & FontLoader -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    
    <style>
        * {
            font-family: 'Cairo', sans-serif;
            box-sizing: border-box;
        }
        .mono-font {
            font-family: 'JetBrains Mono', monospace;
        }
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.8);
        }
        ::-webkit-scrollbar-thumb {
            background: #06b6d4;
            border-radius: 4px;
        }
        #webgl-container {
            width: 100vw;
            height: 100vh;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
            background: radial-gradient(circle at center, #1e293b 0%, #090d16 100%);
        }
        .glass-card {
            background: rgba(11, 17, 32, 0.82);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(6, 182, 212, 0.25);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
        }
        .glow-cyan {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.35);
        }
        /* 3D Label Pins overlay */
        .annotation-pin {
            position: absolute;
            transform: translate(-50%, -50%);
            pointer-events: auto;
            cursor: pointer;
            transition: opacity 0.3s ease, transform 0.2s ease;
            z-index: 10;
        }
        .annotation-pin:hover {
            transform: translate(-50%, -50%) scale(1.08);
        }
        .pin-line {
            position: absolute;
            background: rgba(6, 182, 212, 0.8);
            height: 1.5px;
            transform-origin: 0 0;
            pointer-events: none;
            z-index: 9;
            box-shadow: 0 0 6px rgba(6, 182, 212, 0.8);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 overflow-hidden select-none">

    <!-- 3D Canvas -->
    <div id="webgl-container"></div>

    <!-- Dynamic 3D Annotation Pins Overlay Container -->
    <div id="annotations-overlay" class="absolute inset-0 pointer-events-none z-20 overflow-hidden"></div>

    <!-- UI Overlay Layer -->
    <div class="relative z-30 w-full h-screen pointer-events-none flex flex-col justify-between p-4 md:p-6">

        <!-- Top Navigation Bar -->
        <header class="flex justify-between items-start pointer-events-auto">
            <div class="glass-card p-4 rounded-2xl flex items-center gap-3 border-cyan-500/30">
                <div class="w-11 h-11 rounded-xl bg-cyan-500/10 border border-cyan-400/40 flex items-center justify-center text-cyan-400">
                    <i data-lucide="layers" class="w-6 h-6 animate-pulse"></i>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-black text-xl md:text-2xl tracking-wide text-white">AIHS-2026</h1>
                        <span class="bg-cyan-500/20 text-cyan-300 text-xs px-2.5 py-0.5 rounded-full border border-cyan-500/40 font-bold">نموذج تفكيكي واقعي</span>
                    </div>
                    <p class="text-xs text-slate-300">السوار الذكي الثوري لمراقبة صحة الحجاج - التصميم الهندسي المتكامل</p>
                </div>
            </div>

            <!-- Top Specs Quick Badges -->
            <div class="hidden lg:flex items-center gap-3">
                <div class="glass-card px-4 py-2 rounded-xl text-center">
                    <span class="text-[10px] text-slate-400 block">الهيكل الخارجي</span>
                    <span class="text-xs font-bold text-cyan-400">TPU + Solar Grid</span>
                </div>
                <div class="glass-card px-4 py-2 rounded-xl text-center">
                    <span class="text-[10px] text-slate-400 block">الحساس الطبي</span>
                    <span class="text-xs font-bold text-emerald-400">MAX86150 Dual PPG</span>
                </div>
                <div class="glass-card px-4 py-2 rounded-xl text-center">
                    <span class="text-[10px] text-slate-400 block">البطارية والوزن</span>
                    <span class="text-xs font-bold text-amber-400">1200mAh / 45g</span>
                </div>
            </div>
        </header>

        <!-- Middle Section: Active Component Spec Card Drawer -->
        <main class="flex justify-between items-center my-auto pointer-events-none">
            <div id="spec-card" class="glass-card p-5 rounded-2xl w-80 md:w-96 pointer-events-auto transition-all duration-500 transform translate-x-0">
                <div class="flex justify-between items-start mb-3">
                    <span id="card-badge" class="bg-cyan-950 text-cyan-400 border border-cyan-800 text-[10px] px-2.5 py-0.5 rounded-full mono-font font-bold">
                        COMPONENT #01
                    </span>
                    <span id="card-type" class="text-[10px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded-md">
                        طبي / إلكتروني
