                </div>

                <h2 id="card-title" class="text-lg font-black text-white mb-1">انقر على أي قطعة لمعاينة تفاصيلها</h2>
                <p id="card-subtitle" class="text-xs text-cyan-400 mono-font mb-3">Interactive Assembly Inspection</p>

                <div class="bg-slate-900/90 p-3 rounded-xl border border-slate-800 mb-3">
                    <p id="card-desc" class="text-xs text-slate-300 leading-relaxed">
                        استخدم شريط التحكم السفلي لتفكيك السوار ثلاثي الأبعاد برؤية واقعية تحاكي المخطط المرجعي. يمكنك الضغط على القطع أو التسميات لمعاينتها بالكامل.
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-2 text-xs">
                    <div class="bg-slate-900/60 p-2 rounded-lg border border-slate-800/80">
                        <span class="text-[10px] text-slate-400 block">الموديل / المادة:</span>
                        <span id="card-model" class="text-cyan-300 font-semibold mono-font">AIHS-2026 Specs</span>
                    </div>
                    <div class="bg-slate-900/60 p-2 rounded-lg border border-slate-800/80">
                        <span class="text-[10px] text-slate-400 block">الوظيفة الأساسية:</span>
                        <span id="card-power" class="text-amber-300 font-semibold">تكامل المعالجة</span>
                    </div>
                </div>
            </div>
        </main>

        <!-- Bottom Controls Bar -->
        <footer class="glass-card p-4 rounded-2xl flex flex-col md:flex-row items-center justify-between gap-4 pointer-events-auto border-cyan-500/30">
            <!-- Left Action Buttons -->
            <div class="flex items-center gap-3 w-full md:w-auto">
                <button id="auto-explode-btn" class="flex-1 md:flex-none bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition-all flex items-center justify-center gap-2 glow-cyan">
                    <i data-lucide="play" class="w-4 h-4"></i>
                    <span id="auto-btn-txt">تشغيل أنيميشن التفكيك</span>
                </button>
                <button id="reset-cam-btn" class="bg-slate-800 hover:bg-slate-700 text-slate-300 p-2.5 rounded-xl transition-all border border-slate-700" title="إعادة ضبط الكاميرا">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </button>
                <button id="toggle-labels-btn" class="bg-cyan-950/80 hover:bg-cyan-900 text-cyan-300 p-2.5 rounded-xl transition-all border border-cyan-800" title="إخفاء/إظهار التسميات">
                    <i data-lucide="tag" class="w-4 h-4"></i>
                </button>
            </div>

            <!-- Center Explode Progress Slider -->
            <div class="flex-1 w-full max-w-md flex items-center gap-3 bg-slate-900/80 px-4 py-2 rounded-xl border border-slate-800">
                <span class="text-xs font-bold text-cyan-400 whitespace-nowrap flex items-center gap-1">
                    <i data-lucide="unfold-vertical" class="w-4 h-4"></i> التفكيك:
                </span>
                <input id="explode-slider" type="range" min="0" max="100" value="45" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400">
                <span id="explode-percent" class="text-xs font-bold text-cyan-300 mono-font w-10 text-left">45%</span>
            </div>

            <!-- Right Presets View Buttons -->
            <div class="flex items-center gap-2">
                <button class="view-preset bg-slate-800 hover:bg-cyan-950 text-slate-300 hover:text-cyan-300 text-xs px-3 py-2 rounded-lg border border-slate-700 transition-all" data-preset="diag">منظور</button>
                <button class="view-preset bg-slate-800 hover:bg-cyan-950 text-slate-300 hover:text-cyan-300 text-xs px-3 py-2 rounded-lg border border-slate-700 transition-all" data-preset="front">أمامي</button>
                <button class="view-preset bg-slate-800 hover:bg-cyan-950 text-slate-300 hover:text-cyan-300 text-xs px-3 py-2 rounded-lg border border-slate-700 transition-all" data-preset="top">علوي</button>
            </div>
        </footer>
    </div>

    <script>
